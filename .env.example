# ==============================================================================
# Environnement pour l'éditeur collaboratif
# Copier dans .env.local pour le développement local :
#   cp .env.example .env.local
# ==============================================================================

APP_ENV=local
AWS_REGION=eu-west-3
TABLE_PREFIX=editeur-local-

# DynamoDB Local (port 8000)
DDB_ENDPOINT=http://localhost:8000

# MinIO (port 9000 pour l'API, 9001 pour la console web)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=editeur-local-data

# ElasticMQ (port 9324)
SQS_ENDPOINT=http://localhost:9324
PDF_QUEUE_URL=http://localhost:9324/000000000000/pdf-jobs
PDF_DLQ_URL=http://localhost:9324/000000000000/pdf-jobs-dlq

# E-mail (Mailpit en local, SES sur AWS)
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=journal@association.local

# DynamoDB Streams (inline en local, DynamoDB Streams -> Lambda sur AWS)
STREAM_MODE=inline

# Secrets d'authentification et d'API internes (valeurs de test en local)
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars-long!
INTERNAL_TOKEN=dev-internal-token-for-collab-http-port-1235
ADMIN_TOKEN=dev-admin-supervision-token-secret-2026

# Serveur Hocuspocus (WebSocket) et serveur HTTP interne
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
COLLAB_PORT=1234
COLLAB_INTERNAL_PORT=1235
COLLAB_INTERNAL_HOST=127.0.0.1
COLLAB_INTERNAL_URL=http://localhost:1235

# Règles métier et quotas
DAILY_CREDIT=10000
MAX_DOWNLOADS_CAP=1000
PRESIGN_TTL_SEC=60
HEAD_COALESCE_MS=1000
MAX_UPDATE_BYTES=65536
MAX_AWARENESS_BYTES=2048

# Détection d'abus et limitations
ABUSE_THRESHOLD=10
ABUSE_WINDOW_SEC=60
BLOCK_DURATION_SEC=900
RATE_MAX_UPDATES_PER_SEC=50
RESTORE_MAX_PER_HOUR=10
RESERVATION_MAX_AGE_SEC=600

# Snapshots et journal Yjs
SNAPSHOT_EVERY_UPDATES=100
SNAPSHOT_EVERY_SEC=300
JOURNAL_TTL_DAYS=30

LOG_LEVEL=info

# Identifiants AWS factices requis par le SDK AWS pour les services locaux
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
