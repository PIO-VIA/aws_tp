{
  "name": "helloworld",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#standard-fonts/*": "./node_modules/pdfkit/js/standard-fonts/*.cjs"
  },
  "scripts": {
    "dev": "concurrently -k -n next,collab,sqs,rec -c blue,magenta,yellow,cyan \"next dev\" \"tsx watch --env-file-if-exists=.env.local collab/server.ts\" \"tsx --env-file-if-exists=.env.local scripts/local-sqs-poller.ts\" \"tsx --env-file-if-exists=.env.local scripts/local-reconciler.ts\"",
    "dev:all": "npm run local:up && npm run local:init && npm run dev",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down -v",
    "local:init": "tsx --env-file-if-exists=.env.local scripts/local-init.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "build": "next build",
    "build:collab": "tsx scripts/build-collab.ts",
    "build:lambdas": "tsx --env-file-if-exists=.env.local scripts/build-lambdas.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:scenarios": "vitest run tests/scenarios",
    "test:report:unit": "vitest run tests/unit --reporter=json --outputFile=test-results/unit.json",
    "test:report:integration": "vitest run tests/integration --reporter=json --outputFile=test-results/integration.json",
    "test:report:scenarios": "vitest run tests/scenarios --reporter=json --outputFile=test-results/scenarios.json",
    "report": "tsx scripts/gen-test-report.ts",
    "test:all:report": "npm run test:report:unit && npm run test:report:integration && npm run test:report:scenarios && npm run report",
    "loadtest:download": "tsx --env-file-if-exists=.env.local loadtest/download-burst.ts",
    "loadtest:collab": "tsx --env-file-if-exists=.env.local loadtest/collab-sim.ts",
    "loadtest:combined": "tsx --env-file-if-exists=.env.local loadtest/combined.ts",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke.ts",
    "brand:build": "tsx scripts/generate-brand-assets.ts",
    "check:ui": "tsx scripts/check-no-emoji.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/client-sesv2": "3.1156.0",
    "@aws-sdk/client-sqs": "3.1156.0",
    "@aws-sdk/client-ssm": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@hocuspocus/provider": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "codemirror": "6.0.2",
    "jose": "6.2.13",
    "lib0": "0.2.119",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
